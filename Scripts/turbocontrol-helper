#!/bin/bash
# TurboControl Privileged Helper for Intel Turbo Boost and Fan Management

KEXT_PATH="/Library/Extensions/DisableTurboBoost.kext"
FALLBACK_KEXT="/Applications/TurboControl.app/Contents/Resources/DisableTurboBoost.kext"
BUNDLE_ID="com.rugarciap.DisableTurboBoost"

FAN_BINARY="/usr/local/bin/turbocontrol-fan"
FALLBACK_FAN="/Applications/TurboControl.app/Contents/Resources/turbocontrol-fan"

is_kext_loaded() {
    /usr/sbin/kextstat -b "$BUNDLE_ID" 2>/dev/null | grep -q "$BUNDLE_ID" || \
    /usr/bin/kmutil showloaded --bundle-identifier "$BUNDLE_ID" 2>/dev/null | grep -q "$BUNDLE_ID"
}

case "$1" in
    status)
        if is_kext_loaded; then
            echo "DISABLED"
            exit 0
        else
            echo "ENABLED"
            exit 0
        fi
        ;;
    disable)
        if [ ! -d "$KEXT_PATH" ]; then
            if [ -d "$FALLBACK_KEXT" ]; then
                cp -R "$FALLBACK_KEXT" "$KEXT_PATH" 2>/dev/null
            fi
        fi
        KM_OUT=""
        KM_RC=0
        if [ -d "$KEXT_PATH" ]; then
            xattr -cr "$KEXT_PATH" 2>/dev/null || true
            chown -R root:wheel "$KEXT_PATH" 2>/dev/null
            chmod -R 755 "$KEXT_PATH" 2>/dev/null
            if [ -x /usr/bin/kmutil ]; then
                KM_OUT=$(/usr/bin/kmutil load -p "$KEXT_PATH" 2>&1)
                KM_RC=$?
            fi
            if ! is_kext_loaded; then
                KEXTLOAD_OUT=$(/sbin/kextload "$KEXT_PATH" 2>&1 || /usr/bin/kextutil "$KEXT_PATH" 2>&1)
                KM_OUT="$KM_OUT $KEXTLOAD_OUT"
            fi
        else
            echo "KEXT_NOT_FOUND"
            exit 1
        fi
        if is_kext_loaded; then
            echo "DISABLED"
            exit 0
        else
            if [ "$KM_RC" -eq 27 ] || echo "$KM_OUT" | grep -qiE "approval|System Policy|User approval"; then
                echo "NEEDS_APPROVAL"
                exit 27
            elif [ "$KM_RC" -eq 28 ] || echo "$KM_OUT" | grep -qiE "reboot|restart"; then
                echo "NEEDS_REBOOT"
                exit 28
            else
                echo "FAILED_TO_DISABLE: $KM_OUT"
                exit 1
            fi
        fi
        ;;
    enable)
        /sbin/kextunload -b "$BUNDLE_ID" 2>/dev/null || /usr/bin/kmutil unload -b "$BUNDLE_ID" 2>/dev/null
        if is_kext_loaded; then
            echo "FAILED_TO_ENABLE"
            exit 1
        else
            echo "ENABLED"
            exit 0
        fi
        ;;
    fan)
        FAN_EXEC="$FALLBACK_FAN"
        if [ ! -f "$FAN_EXEC" ]; then
            FAN_EXEC="$FAN_BINARY"
        fi
        if [ ! -f "$FAN_EXEC" ]; then
            echo "FAN_BINARY_NOT_FOUND"
            exit 1
        fi
        case "$2" in
            auto)
                "$FAN_EXEC" auto
                exit $?
                ;;
            manual)
                if [[ "$3" =~ ^[0-9]+$ ]]; then
                    "$FAN_EXEC" manual "$3"
                    exit $?
                else
                    echo "INVALID_RPM"
                    exit 1
                fi
                ;;
            *)
                echo "INVALID_FAN_COMMAND"
                exit 1
                ;;
        esac
        ;;
    cpu_freq)
        /usr/bin/powermetrics --samplers cpu_power -n 1 -i 150 2>/dev/null | /usr/bin/awk -F: '
            /System Average frequency as fraction of nominal/ {
                if (match($0, /\([0-9]+(\.[0-9]+)? [Mm][Hh][Zz]\)/)) {
                    s = substr($0, RSTART + 1, RLENGTH - 2)
                    sub(/ [Mm][Hh][Zz]/, "", s)
                    print s
                    found = 1
                    exit
                }
                if (match($2, /[0-9]+(\.[0-9]+)?/)) {
                    pct = substr($2, RSTART, RLENGTH) + 0
                }
            }
            /CPU Average frequency as fraction of nominal/ {
                if (pct == 0 && match($2, /[0-9]+(\.[0-9]+)?/)) {
                    pct = substr($2, RSTART, RLENGTH) + 0
                }
            }
            /CPU [0-9]+ frequency|HW active frequency|CPU frequency/ {
                if (match($2, /[0-9]+(\.[0-9]+)?/)) {
                    val = substr($2, RSTART, RLENGTH) + 0
                    if ($0 ~ /GHz/) val = val * 1000
                    print val
                    found = 1
                    exit
                }
            }
            END {
                if (!found && pct > 0) {
                    print "PCT:" pct
                }
            }'
        exit 0
        ;;
    *)
        echo "Usage: $0 {status|disable|enable|fan [auto|manual <rpm>]|cpu_freq}"
        exit 1
        ;;
esac
